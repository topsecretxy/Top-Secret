
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CINEMAX - Movie World</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#101014;color:#fff;font-family:Arial,sans-serif}
header{background:#1b1b22;padding:18px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;border-bottom:3px solid #e50914}
.logo{font-size:25px;font-weight:bold;color:#fff;text-decoration:none}
.logo span{color:#e50914}
.search{display:flex;gap:5px}
input{width:150px;min-width:0;padding:10px;background:#292930;color:white;border:1px solid #444;border-radius:5px}
button,.watch{background:#e50914;color:white;border:0;padding:10px 14px;border-radius:5px;font-weight:bold;cursor:pointer}
main{max-width:1100px;margin:auto;padding:20px 14px}
.hero{padding:28px 20px;background:linear-gradient(120deg,#4a111a,#22222b);border-radius:10px;margin-bottom:25px}
.hero h1{margin-top:0}
.hero p{color:#ddd;line-height:1.5}
h2{font-size:21px}
.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.card{background:#222229;border-radius:8px;overflow:hidden}
.poster{width:100%;aspect-ratio:2/3;object-fit:cover;display:block;background:#34343d}
.info{padding:10px}
.info h3{font-size:15px;margin:4px 0 8px}
.info p{font-size:13px;color:#bbb}
.watch{display:block;text-align:center;text-decoration:none;margin-top:12px}
footer{text-align:center;color:#aaa;padding:25px}
@media(max-width:700px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
</head>
<body>
<header>
<a class="logo" href="#">CINE<span>MAX</span></a>
<form class="search" id="searchForm">
<input id="search" placeholder="Search movies..." aria-label="Search movies">
<button>Search</button>
</form>
</header>
<main>
<section class="hero">
<h1>Discover Your Next Movie</h1>
<p>Explore movie reviews, trailers and entertainment news.</p>
</section>
<h2>Featured Movies</h2>
<div class="grid" id="movies">
<article class="card">
<img class="poster" src="https://placehold.co/400x600/34202a/ffffff?text=Movie+One" alt="Movie One poster">
<div class="info"><h3>Movie One</h3><p>Action · Movie review</p><a class="watch" href="https://example.com">View Details</a></div>
</article>
<article class="card">
<img class="poster" src="https://placehold.co/400x600/242c40/ffffff?text=Movie+Two" alt="Movie Two poster">
<div class="info"><h3>Movie Two</h3><p>Adventure · Movie review</p><a class="watch" href="https://example.com">View Details</a></div>
</article>
<article class="card">
<img class="poster" src="https://placehold.co/400x600/3b2525/ffffff?text=Movie+Three" alt="Movie Three poster">
<div class="info"><h3>Movie Three</h3><p>Comedy · Movie review</p><a class="watch" href="https://example.com">View Details</a></div>
</article>
<article class="card">
<img class="poster" src="https://placehold.co/400x600/20363b/ffffff?text=Movie+Four" alt="Movie Four poster">
<div class="info"><h3>Movie Four</h3><p>Sci-Fi · Movie review</p><a class="watch" href="https://example.com">View Details</a></div>
</article>
</div>
</main>
<footer>© 2026 CINEMAX · Movie reviews and entertainment</footer>
<script>
document.getElementById('searchForm').addEventListener('submit',function(e){
e.preventDefault();
const q=document.getElementById('search').value.trim().toLowerCase();
document.querySelectorAll('.card').forEach(card=>{
card.style.display=card.innerText.toLowerCase().includes(q)?'':'none';
});
});
</script>
</body>
</html>
