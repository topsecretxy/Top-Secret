<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:version='2'
  expr:dir='data:blog.languageDirection'
  xmlns='http://www.w3.org/1999/xhtml'
  xmlns:b='http://www.google.com/2005/gml/b'
  xmlns:data='http://www.google.com/2005/gml/data'
  xmlns:expr='http://www.google.com/2005/gml/expr'>

<head>
  <b:include data='blog' name='all-head-content'/>
  <meta name='viewport' content='width=device-width, initial-scale=1'/>
  <meta name='theme-color' content='#101010'/>
  <title><data:blog.pageTitle/></title>

  <b:skin><![CDATA[
    :root {
      --bg: #101010;
      --panel: #202020;
      --red: #e32636;
      --text: #f6f6f6;
      --muted: #aaaaaa;
      --border: #363636;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: Arial, sans-serif;
      line-height: 1.6;
    }

    a { color: inherit; text-decoration: none; }

    .header {
      background: #171717;
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .header-inner {
      max-width: 1300px;
      margin: auto;
      padding: 14px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    .logo {
      font-size: 25px;
      font-weight: 900;
      white-space: nowrap;
    }

    .logo span { color: var(--red); }

    .search-form {
      display: flex;
      flex: 1;
      max-width: 560px;
    }

    .search-form input {
      width: 100%;
      min-width: 0;
      background: #101010;
      border: 1px solid #444;
      color: white;
      padding: 11px 13px;
      border-radius: 6px 0 0 6px;
    }

    .search-form button {
      border: 0;
      background: var(--red);
      color: white;
      padding: 0 16px;
      font-weight: bold;
      border-radius: 0 6px 6px 0;
      cursor: pointer;
    }

    .age-strip {
      background: #341719;
      color: #ffb7bd;
      text-align: center;
      padding: 8px 12px;
      font-size: 12px;
    }

    .nav {
      display: flex;
      gap: 22px;
      padding: 12px 20px;
      max-width: 1300px;
      margin: auto;
      overflow-x: auto;
      white-space: nowrap;
    }

    .nav a { font-size: 14px; }
    .nav a:hover { color: #ff626e; }

    .container {
      max-width: 1300px;
      margin: auto;
      padding: 24px 20px 40px;
    }

    .welcome {
      background: #211719;
      border: 1px solid #49272c;
      border-left: 4px solid var(--red);
      border-radius: 8px;
      padding: 18px;
      margin-bottom: 26px;
    }

    .welcome h1 {
      font-size: 23px;
      margin: 0 0 5px;
    }

    .welcome p {
      color: var(--muted);
      font-size: 14px;
      margin: 0;
    }

    .section-title {
      font-size: 22px;
      margin: 0 0 18px;
    }

    .section-title span { color: var(--red); }

    /* Post cards */

    #main { min-width: 0; }

    .blog-posts {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      align-items: start;
    }

    .blog-posts .post-outer {
      min-width: 0;
      overflow: hidden;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 9px;
      padding: 12px;
    }

    .blog-posts .post-outer:hover {
      border-color: var(--red);
    }

    .post-title {
      font-size: 16px;
      line-height: 1.45;
      margin: 9px 0;
    }

    .post-title a:hover { color: #ff6872; }

    .post-body {
      color: #dedede;
      font-size: 14px;
      overflow-wrap: anywhere;
    }

    .post-body img {
      display: block;
      width: 100%;
      height: auto;
      max-height: 300px;
      object-fit: cover;
      border-radius: 6px;
      margin-bottom: 10px;
    }

    .post-body iframe,
    .post-body video {
      max-width: 100%;
    }

    .post-body a {
      color: #ff727c;
    }

    .post-body a.watch-button {
      display: inline-block;
      background: var(--red);
      color: white;
      padding: 9px 14px;
      border-radius: 5px;
      font-weight: bold;
      margin: 8px 0;
    }

    .post-header,
    .post-footer,
    .post-labels {
      color: var(--muted);
      font-size: 12px;
    }

    .item-view .blog-posts { display: block; }

    .item-view .blog-posts .post-outer {
      padding: 20px;
    }

    .item-view .post-title { font-size: 25px; }

    .item-view .post-body img {
      height: auto;
      max-height: none;
    }

    .blog-pager {
      display: flex;
      justify-content: space-between;
      padding: 24px 0;
      gap: 10px;
    }

    .blog-pager a {
      background: #272727;
      border: 1px solid var(--border);
      padding: 9px 14px;
      border-radius: 5px;
    }

    .footer {
      border-top: 1px solid var(--border);
      background: #171717;
      text-align: center;
      padding: 25px 15px;
      color: var(--muted);
      font-size: 13px;
    }

    .footer-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 17px;
      margin-bottom: 12px;
    }

    /* Age confirmation */

    .age-overlay {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 18px;
      background: rgba(0,0,0,.96);
    }

    .age-overlay[hidden] { display: none; }

    .age-box {
      max-width: 410px;
      width: 100%;
      text-align: center;
      background: #202020;
      border: 1px solid #493035;
      border-radius: 12px;
      padding: 28px 22px;
    }

    .age-icon {
      display: inline-block;
      color: white;
      background: var(--red);
      padding: 10px 16px;
      border-radius: 8px;
      font-size: 23px;
      font-weight: 900;
    }

    .age-box h2 { margin-bottom: 8px; }

    .age-box p {
      color: var(--muted);
      font-size: 14px;
    }

    .age-actions {
      display: grid;
      gap: 10px;
      margin-top: 20px;
    }

    .age-actions button {
      border: 0;
      border-radius: 6px;
      padding: 12px;
      cursor: pointer;
      font-weight: bold;
    }

    .age-yes {
      background: var(--red);
      color: white;
    }

    .age-no {
      background: #383838;
      color: white;
    }

    @media (min-width: 1150px) {
      .blog-posts {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    @media (max-width: 800px) {
      .header-inner { flex-wrap: wrap; }

      .search-form {
        order: 3;
        flex-basis: 100%;
        max-width: none;
      }

      .blog-posts {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }
    }

    @media (max-width: 480px) {
      .header-inner { padding: 12px; }
      .nav { padding: 10px 12px; gap: 18px; }
      .container { padding: 16px 10px 30px; }
      .blog-posts .post-outer { padding: 8px; }
      .post-title { font-size: 14px; }
      .post-body { font-size: 13px; }
      .welcome { padding: 13px; }
      .item-view .blog-posts .post-outer { padding: 13px; }
      .item-view .post-title { font-size: 22px; }
    }
  ]]></b:skin>
</head>

<body>

  <header class='header'>
    <div class='header-inner'>
      <a class='logo' expr:href='data:blog.homepageUrl'>
        RED<span>LINK</span>
      </a>

      <form action='/search' method='get' class='search-form'>
        <input type='search' name='q'
          placeholder='Search posts...'
          aria-label='Search posts'/>
        <button type='submit'>Search</button>
      </form>
    </div>
  </header>

  <div class='age-strip'>
    18+ ONLY · Adults only · Follow local laws
  </div>

  <nav class='nav'>
    <a expr:href='data:blog.homepageUrl'>Home</a>
    <a href='/search/label/Featured'>Featured</a>
    <a href='/search/label/Latest'>Latest</a>
    <a href='/search/label/Popular'>Popular</a>
    <a href='/p/about.html'>About</a>
    <a href='/p/contact.html'>Contact</a>
  </nav>

  <main class='container'>

    <section class='welcome'>
      <h1>Discover Video Links</h1>
      <p>
        Browse posts and follow authorized external links.
        Only content you have legal permission to share is allowed.
      </p>
    </section>

    <h2 class='section-title'>
      <span>&#9679;</span> Latest Posts
    </h2>

    <b:section id='main' class='main'
      maxwidgets='1' showaddelement='no'>

      <b:widget id='Blog1' type='Blog'
        title='Posts' locked='true'
        version='2' visible='true'/>

    </b:section>

  </main>

  <footer class='footer'>
    <nav class='footer-links'>
      <a href='/p/about.html'>About</a>
      <a href='/p/privacy-policy.html'>Privacy</a>
      <a href='/p/terms.html'>Terms</a>
      <a href='/p/dmca.html'>Copyright / DMCA</a>
      <a href='/p/contact.html'>Contact</a>
    </nav>
    <p>© <data:blog.title/>. All rights reserved.</p>
  </footer>

  <div class='age-overlay' id='ageOverlay' hidden='hidden'>
    <div class='age-box' role='dialog'
      aria-modal='true' aria-labelledby='ageTitle'>

      <div class='age-icon'>18+</div>
      <h2 id='ageTitle'>Age Confirmation</h2>

      <p>
        This website is intended for adults. Continue only if
        you meet the legal age requirement in your location.
      </p>

      <div class='age-actions'>
        <button class='age-yes' id='ageYes' type='button'>
          I am of legal age — Continue
        </button>
        <button class='age-no' id='ageNo' type='button'>
          I am underage — Leave
        </button>
      </div>
    </div>
  </div>

  <script type='text/javascript'>
  //<![CDATA[
  (function () {
    var overlay = document.getElementById('ageOverlay');
    var yes = document.getElementById('ageYes');
    var no = document.getElementById('ageNo');
    var storageKey = 'redlink_age_confirmed';

    try {
      if (sessionStorage.getItem(storageKey) !== 'yes') {
        overlay.hidden = false;
      }
    } catch (e) {
      overlay.hidden = false;
    }

    yes.addEventListener('click', function () {
      try {
        sessionStorage.setItem(storageKey, 'yes');
      } catch (e) {}
      overlay.hidden = true;
    });

    no.addEventListener('click', function () {
      window.location.replace('https://www.google.com/');
    });
  })();
  //]]>
  </script>

</body>
</html>
